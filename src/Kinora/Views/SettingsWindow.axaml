<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kinora.ViewModels"
        xmlns:k="using:Kinora"
        x:Class="Kinora.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Icon="/Assets/kinora-256.png"
        Width="720" Height="680" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Button Content="Done" Classes="accent" HorizontalAlignment="Right" IsDefault="True" Click="OnDone" />
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24" Spacing="18">
                <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" />

                <!-- Library folders -->
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="heading" Text="Library folders" />
                            <TextBlock Classes="subtle" TextWrapping="Wrap"
                                       Text="The folders Kinora builds the library from. Movies: each in its own folder, or loose files. TV shows: one folder per show, with season folders inside." />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Roots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RootItem">
                                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <Path Classes="icon" Data="{x:Static k:Icons.Folder}" Margin="0,0,14,0" VerticalAlignment="Center"
                                                  Stroke="{DynamicResource SubtleText}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <Border Classes="badge"><TextBlock Text="{Binding KindText}" FontSize="11" /></Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Path}" Classes="subtle" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Change path" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    ToolTip.Tip="The share moved (another drive letter, another computer): point Kinora to it without scanning again"
                                                    Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).ChangeRootPathCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="3" Content="Remove" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).RemoveRootCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Add a folder" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding NewRootPath}" PlaceholderText="\\nas\movies, M:\Movies, /mnt/nas/movies" />
                                <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseCommand}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox Text="{Binding NewRootName}" PlaceholderText="Name shown in the sidebar" />
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding NewRootKindIndex}" Margin="8,0,0,0" MinWidth="130">
                                    <ComboBoxItem Content="Movies" />
                                    <ComboBoxItem Content="TV shows" />
                                </ComboBox>
                                <Button Grid.Column="2" Content="Add" Classes="accent" Padding="18,6" Margin="8,0,0,0"
                                        Command="{Binding AddRootCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding AddError}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                                       IsVisible="{Binding AddError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Online metadata -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="heading" Text="Online metadata (TMDB)" />
                            <TextBlock Classes="subtle" TextWrapping="Wrap"
                                       Text="What the movie folders don't say (plot, cast, posters, the movies without an nfo) comes from The Movie Database. What the folders say always wins." />
                        </StackPanel>
                        <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Text="API key" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding TmdbKey}" PasswordChar="●" RevealPassword="False"
                                     PlaceholderText="API key or read access token" />
                            <Button Grid.Column="2" Content="Test" Margin="8,0,0,0" Command="{Binding TestKeyCommand}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4" Margin="0,6,0,0">
                                <TextBlock Text="{Binding KeyStatus}" VerticalAlignment="Center" TextWrapping="Wrap"
                                           IsVisible="{Binding KeyStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <Button Classes="link" Content="Get a key on themoviedb.org" Padding="0" Background="Transparent" HorizontalAlignment="Left"
                                        Foreground="{DynamicResource AccentBrush}" Command="{Binding OpenTmdbApiPageCommand}" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="Language" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding MetadataLanguage}"
                                      MinWidth="240" Margin="0,12,0,0" />
                        </Grid>
                        <CheckBox IsChecked="{Binding FetchAfterScan}" Content="After a scan, download what is missing" />
                        <StackPanel Spacing="2">
                            <CheckBox IsChecked="{Binding WriteToMediaFolders}" Content="Save downloaded metadata and pictures in the movie folders" />
                            <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="28,0,0,0" FontSize="12"
                                       Text="Off: Kinora only reads the movie folders and keeps what it downloads to itself. On: a movie.nfo and the pictures a folder lacks are written there, where Emby, Jellyfin and Kodi find them too. Files already there are never replaced." />
                        </StackPanel>
                        <!-- Required by TMDB's terms of use -->
                        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap"
                                   Text="This product uses the TMDB API but is not endorsed or certified by TMDB." />
                    </StackPanel>
                </Border>

                <!-- Subtitles -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="heading" Text="Subtitles (OpenSubtitles)" />
                            <TextBlock Classes="subtle" TextWrapping="Wrap"
                                       Text="Search and download subtitles from a movie or episode page. Searching needs the API key; downloading also needs your OpenSubtitles account, and counts against its daily downloads. Subtitles are saved next to the video." />
                        </StackPanel>
                        <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Text="API key" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding OpenSubtitlesKey}" PasswordChar="●" PlaceholderText="Your application's API key" />
                            <Button Grid.Column="2" Content="Test" Margin="8,0,0,0" Command="{Binding TestOpenSubtitlesCommand}" />

                            <TextBlock Grid.Row="1" Text="User name" VerticalAlignment="Center" Margin="0,8,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OpenSubtitlesUser}" Margin="0,8,0,0" />

                            <TextBlock Grid.Row="2" Text="Password" VerticalAlignment="Center" Margin="0,8,0,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OpenSubtitlesPassword}" PasswordChar="●" Margin="0,8,0,0" />

                            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4" Margin="0,6,0,0">
                                <TextBlock Text="{Binding SubtitlesStatus}" VerticalAlignment="Center" TextWrapping="Wrap"
                                           IsVisible="{Binding SubtitlesStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <Button Content="Get a key on opensubtitles.com" Padding="0" Background="Transparent" HorizontalAlignment="Left"
                                        Foreground="{DynamicResource AccentBrush}" Command="{Binding OpenOpenSubtitlesPageCommand}" />
                            </StackPanel>

                            <TextBlock Grid.Row="4" Text="Languages" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SubtitleLanguages}" Margin="0,12,0,0"
                                     PlaceholderText="Codes in order of preference: it, en" />
                        </Grid>
                        <CheckBox IsChecked="{Binding SkipMachineTranslated}" Content="Hide machine-translated subtitles" />
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="heading" Text="Appearance" />
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" >
                            <TextBlock Text="Theme" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding ThemeIndex}" MinWidth="200">
                                <ComboBoxItem Content="Same as the system" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" Text="Poster size" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="120" Maximum="280" Value="{Binding CardWidth}"
                                    MaxWidth="320" HorizontalAlignment="Left" Width="320" Margin="0,12,0,0" />
                            <TextBlock Grid.Row="2" Text="Scroll speed" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="6" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                    Value="{Binding ScrollSpeed}" ToolTip.Tip="How far one notch of the mouse wheel scrolls"
                                    MaxWidth="320" HorizontalAlignment="Left" Width="320" Margin="0,12,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Behaviour -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="heading" Text="Library" />
                        <CheckBox IsChecked="{Binding ScanOnStartup}" Content="Look for changes when Kinora starts" />
                    </StackPanel>
                </Border>

                <!-- Playback -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="heading" Text="Playback" />
                        <TextBlock Text="Play movies and episodes with" />
                        <RadioButton GroupName="Player" IsChecked="{Binding UseBuiltInPlayer}" Content="Kinora's player" />
                        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Margin="28,-6,0,0"
                                   Text="{Binding BuiltInPlayerNote}" />
                        <RadioButton GroupName="Player" IsChecked="{Binding UseSystemPlayer}" Content="{Binding SystemPlayerText}" />
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="heading" Text="Updates" />
                                <TextBlock Classes="subtle" Text="{Binding VersionText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Check now" Command="{Binding CheckUpdatesNowCommand}" />
                                <Button Content="Releases" Command="{Binding OpenReleasesPageCommand}" ToolTip.Tip="All versions on GitHub" />
                                <Button Content="Licenses" Command="{Binding OpenLicensesCommand}" ToolTip.Tip="Kinora is under the MIT License; the notices of the software it uses" />
                            </StackPanel>
                        </Grid>
                        <CheckBox IsChecked="{Binding CheckForUpdates}" Content="Look for a new version when Kinora starts (once a day)" />
                        <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap"
                                   IsVisible="{Binding UpdateStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="heading" Text="Kinora's own data" />
                        <TextBlock Classes="subtle" TextWrapping="Wrap" Text="Database, settings and picture cache. Always on this computer, never in the movie folders." />
                        <Grid ColumnDefinitions="*,Auto">
                            <SelectableTextBlock Text="{Binding DataFolder}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="Open" Margin="8,0,0,0" Command="{Binding OpenDataFolderCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
