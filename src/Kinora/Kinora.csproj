<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Kinora</RootNamespace>
    <AssemblyName>Kinora</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\kinora.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- Built for Windows (on Windows without a runtime given, or for win-*): with Windows' own API
       too, for the media keys and the media panel. Linux and macOS builds stay plain net10.0. -->
  <PropertyGroup Condition="('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT') Or $(RuntimeIdentifier.StartsWith('win'))">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The big icon files are for the installers and the macOS bundle, not for the app itself -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\kinora.icns;Assets\kinora-512.png;Assets\kinora-1024.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- The built-in player: VLC's engine. On Windows it comes with Kinora (64-bit only);
         on macOS and Linux the VLC installed on the computer is used. -->
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24"
                      Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))" />
  </ItemGroup>

  <PropertyGroup>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Streaming out, recording, visualizations, network discovery and scripts: not for playing a file -->
    <VlcWindowsX64ExcludeFiles Include="plugins\stream_out\%2A%2A;plugins\access_output\%2A%2A;plugins\mux\%2A%2A;plugins\visualization\%2A%2A;plugins\video_splitter\%2A%2A;plugins\services_discovery\%2A%2A;lua\%2A%2A;libvlc.lib;libvlccore.lib" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kinora.Core\Kinora.Core.csproj" />
  </ItemGroup>

</Project>
