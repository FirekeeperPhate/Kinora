<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kinora.ViewModels"
             xmlns:k="using:Kinora"
             x:Class="Kinora.Views.CalendarView"
             x:DataType="vm:CalendarViewModel"
             Background="{DynamicResource AppBackground}">

    <UserControl.Styles>
        <Style Selector="Button.row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.row.open">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.row.open:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <!-- As wide as the window, up to a width that still reads well: see the code behind -->
        <StackPanel x:Name="Page" Margin="48,22,48,48" Spacing="26" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="pill" Command="{Binding BackCommand}" HorizontalAlignment="Left" ToolTip.Tip="Back (Esc)" Padding="12,8,16,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="icon" Data="{x:Static k:Icons.Back}" Width="14" Height="14" />
                        <TextBlock Text="Back" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="Coming up" FontSize="34" FontWeight="Bold" />
                    <TextBlock Classes="subtle">
                        <Run Text="{Binding Sources}" />
                        <Run Text="  ·  " />
                        <Run Text="{Binding Summary}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding SpanOptions}" SelectedIndex="{Binding SpanIndex}" MinWidth="150" />
                    <Button Command="{Binding RefreshCommand}" ToolTip.Tip="Ask again" Padding="10,8">
                        <Path Classes="icon" Data="{x:Static k:Icons.Refresh}" Width="15" Height="15" />
                    </Button>
                </StackPanel>
            </Grid>

            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Width="200" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap" Classes="subtle" FontSize="15" />

            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="24" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CalendarDay">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsToday}" />
                                <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold" IsVisible="{Binding !IsToday}" />
                                <TextBlock Text="{Binding Date}" Classes="subtle" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                            </StackPanel>
                            <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="12" ClipToBounds="True">
                                <ItemsControl ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CalendarEntry">
                                            <Button Classes="row" Classes.open="{Binding InLibrary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,10"
                                                    CornerRadius="0" ToolTip.Tip="{Binding Tip}"
                                                    Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).OpenCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="64,Auto,*,Auto">
                                                    <TextBlock Text="{Binding Time}" Classes="subtle" VerticalAlignment="Center" />
                                                    <Panel Grid.Column="1" Width="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Path Classes="icon" Data="{x:Static k:Icons.Film}" Width="16" Height="16" IsVisible="{Binding IsMovie}" />
                                                        <Path Classes="icon" Data="{x:Static k:Icons.Tv}" Width="16" Height="16" IsVisible="{Binding !IsMovie}" />
                                                    </Panel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" Classes="subtle" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <Border Classes="chip" IsVisible="{Binding HasFile}">
                                                            <TextBlock Text="Downloaded" FontSize="12" />
                                                        </Border>
                                                        <Border Classes="chip" IsVisible="{Binding InLibrary}">
                                                            <TextBlock Text="In your library" FontSize="12" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
