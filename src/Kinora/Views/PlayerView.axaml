<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kinora.ViewModels"
             xmlns:views="using:Kinora.Views"
             xmlns:k="using:Kinora"
             x:Class="Kinora.Views.PlayerView"
             x:DataType="vm:PlayerViewModel"
             Background="Black">

    <Panel>
        <views:VideoSurface x:Name="Surface" />

        <!-- The controls. Nothing Avalonia draws can sit over VLC's window, and a popup is held
             inside the work area (not over the taskbar in full screen): in code they move into
             a borderless window of their own, kept over the video. Their styles travel with them.
             Almost transparent rather than transparent, so they also catch the mouse. -->
        <Grid x:Name="OverlayRoot" Background="#01000000" RowDefinitions="Auto,*,Auto">
            <Grid.Resources>
                <!-- The seek and volume bars in Kinora's colour, light on the dark video -->
                <SolidColorBrush x:Key="SliderTrackFill" Color="#55FFFFFF" />
                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#77FFFFFF" />
                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#77FFFFFF" />
                <!-- The player is always dark: the dark theme's accent -->
                <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FF6A5C" />
                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF8274" />
                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF6A5C" />
                <SolidColorBrush x:Key="SliderThumbBackground" Color="White" />
                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="White" />
                <DataTemplate x:Key="TrackRow" x:DataType="vm:TrackChoice">
                    <Button Classes="playerRow" Command="{Binding ChooseCommand}">
                        <Grid ColumnDefinitions="26,*">
                            <Path Classes="icon" Data="{x:Static k:Icons.Check}" Stroke="White" Width="16" Height="16"
                                  HorizontalAlignment="Left" IsVisible="{Binding IsSelected}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </Grid.Resources>
            <Grid.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="Foreground" Value="White" />
                </Style>
                <Style Selector="Button.player, DropDownButton.player, ToggleButton.player">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="9" />
                    <Setter Property="CornerRadius" Value="22" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="Button.player:pointerover /template/ ContentPresenter#PART_ContentPresenter, DropDownButton.player:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.player:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#33FFFFFF" />
                    <Setter Property="Foreground" Value="White" />
                </Style>
                <Style Selector="Button.player:pressed /template/ ContentPresenter#PART_ContentPresenter, DropDownButton.player:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.player:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#55FFFFFF" />
                    <Setter Property="Foreground" Value="White" />
                </Style>
                <Style Selector="ToggleButton.player:checked /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#55FFFFFF" />
                    <Setter Property="Foreground" Value="White" />
                </Style>
                <Style Selector="Button.player Path.icon, DropDownButton.player Path.icon, ToggleButton.player Path.icon">
                    <Setter Property="Stroke" Value="White" />
                    <Setter Property="Width" Value="22" />
                    <Setter Property="Height" Value="22" />
                </Style>
                <Style Selector="Path.icon.filled">
                    <Setter Property="Fill" Value="White" />
                </Style>
                <Style Selector="FlyoutPresenter.player">
                    <Setter Property="Background" Value="#F21A1A22" />
                    <Setter Property="BorderBrush" Value="#33FFFFFF" />
                    <Setter Property="CornerRadius" Value="12" />
                    <Setter Property="Padding" Value="6" />
                </Style>
                <Style Selector="Button.playerRow">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="10,7" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
                <Style Selector="Button.playerRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#33FFFFFF" />
                    <Setter Property="Foreground" Value="White" />
                </Style>
                <Style Selector="Button.playerRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#55FFFFFF" />
                    <Setter Property="Foreground" Value="White" />
                </Style>
                <Style Selector="Button.step">
                    <Setter Property="Background" Value="#22FFFFFF" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style Selector="Border.bar">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="Slider">
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </Grid.Styles>

            <!-- Top: back, and what is playing -->
            <Border Classes="bar" Opacity="{Binding ControlsVisible, Converter={x:Static k:Format.VisibleOpacity}}"
                    IsHitTestVisible="{Binding ControlsVisible}" Padding="20,16,20,48">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#C0000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="Auto,*">
                    <Button Classes="player" Command="{Binding CloseCommand}" ToolTip.Tip="Back (Esc)">
                        <Path Classes="icon" Data="{x:Static k:Icons.Back}" />
                    </Button>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Resumed where it was left -->
            <Border Grid.Row="0" IsVisible="{Binding ShowResume}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,18,24,0" Padding="16,8,8,8" CornerRadius="22" Background="#CC1A1A22">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding ResumeText}" VerticalAlignment="Center" />
                    <Button Classes="player" Padding="14,6" Background="#33FFFFFF" Command="{Binding StartOverCommand}" Content="Start over" />
                </StackPanel>
            </Border>

            <!-- A note on what the keys just did -->
            <Border Grid.Row="1" IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" Padding="16,8"
                    CornerRadius="18" Background="#CC1A1A22">
                <TextBlock Text="{Binding Toast}" />
            </Border>

            <!-- Middle: loading, or what went wrong -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressBar IsIndeterminate="True" Width="160" IsVisible="{Binding IsBuffering}" />
                <Border IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Background="#CC1A1A22" CornerRadius="14" Padding="24,18">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding Message}" FontSize="16" TextWrapping="Wrap" MaxWidth="480" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <Button Classes="player" Padding="18,8" Background="#FF6A5C" Command="{Binding TryAgainCommand}"
                                    Content="Try again" IsVisible="{Binding CanTryAgain}" />
                            <Button Classes="player" Padding="18,8" Background="#33FFFFFF" Command="{Binding EndHereCommand}"
                                    Content="It ends here" IsVisible="{Binding CanEndHere}"
                                    ToolTip.Tip="Take this for the end: marked watched, then the next episode" />
                            <Button Classes="player" Padding="18,8" Background="#33FFFFFF"
                                    Command="{Binding CloseCommand}" Content="Back to Kinora" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- The intro is playing: past it in one click -->
            <Button Grid.Row="1" Classes="player" IsVisible="{Binding ShowSkipIntro}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,16" Padding="20,10" CornerRadius="10" Background="#E61A1A22" BorderBrush="#66FFFFFF" BorderThickness="1"
                    Command="{Binding SkipIntroCommand}" ToolTip.Tip="Skip intro (I)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Skip intro" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Path Classes="icon filled" Data="{x:Static k:Icons.Next}" Width="16" Height="16" />
                </StackPanel>
            </Button>

            <!-- The episode is over: the next one, unless told otherwise -->
            <Border Grid.Row="1" IsVisible="{Binding ShowNextCard}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,16" Padding="20,16" CornerRadius="14" Background="#E61A1A22">
                <StackPanel Spacing="10" MaxWidth="380">
                    <TextBlock Text="Up next" Opacity="0.7" FontSize="12" />
                    <TextBlock Text="{Binding NextTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="player" Padding="16,7" Background="#FF6A5C" Command="{Binding PlayNextCommand}"
                                Content="{Binding NextCountdownText}" />
                        <Button Classes="player" Padding="16,7" Background="#33FFFFFF" Command="{Binding CancelNextCommand}" Content="Cancel" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Bottom: the seek bar and the buttons -->
            <Border x:Name="BottomBar" Grid.Row="2" Classes="bar" Padding="24,48,24,14"
                    Opacity="{Binding ControlsVisible, Converter={x:Static k:Format.VisibleOpacity}}"
                    IsHitTestVisible="{Binding ControlsVisible}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#D0000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding CanSeek}">
                        <TextBlock Text="{Binding TimeText}" VerticalAlignment="Center" MinWidth="60" FontFeatures="tnum" />
                        <Slider x:Name="SeekBar" Grid.Column="1" Minimum="0" Maximum="1000" Margin="12,0"
                                Value="{Binding Progress}" />
                        <TextBlock Grid.Column="2" Text="{Binding LengthText}" VerticalAlignment="Center" MinWidth="60"
                                   TextAlignment="Right" FontFeatures="tnum" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <Button Classes="player" Command="{Binding PlayPauseCommand}" ToolTip.Tip="Play / pause (Space)">
                            <Panel>
                                <Path Classes="icon filled" Data="{x:Static k:Icons.Play}" IsVisible="{Binding !IsPlaying}" />
                                <Path Classes="icon" Data="{x:Static k:Icons.Pause}" IsVisible="{Binding IsPlaying}" StrokeThickness="2.6" />
                            </Panel>
                        </Button>
                        <Button Grid.Column="1" Classes="player" Command="{Binding PlayPreviousCommand}" ToolTip.Tip="Previous episode (P)" IsVisible="{Binding HasPrevious}">
                            <Path Classes="icon filled" Data="{x:Static k:Icons.Previous}" />
                        </Button>
                        <Button Grid.Column="2" Classes="player" Command="{Binding BackCommand}" ToolTip.Tip="{Binding BackTip}">
                            <Panel>
                                <Path Classes="icon" Data="{x:Static k:Icons.Rewind}" />
                                <TextBlock Text="{Binding BackSeconds}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
                            </Panel>
                        </Button>
                        <Button Grid.Column="3" Classes="player" Command="{Binding ForwardCommand}" ToolTip.Tip="{Binding ForwardTip}">
                            <Panel>
                                <Path Classes="icon" Data="{x:Static k:Icons.Forward}" />
                                <TextBlock Text="{Binding ForwardSeconds}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
                            </Panel>
                        </Button>
                        <Button Grid.Column="4" Classes="player" Command="{Binding PlayNextCommand}" ToolTip.Tip="Next episode (N)" IsVisible="{Binding HasNext}">
                            <Path Classes="icon filled" Data="{x:Static k:Icons.Next}" />
                        </Button>

                        <DropDownButton x:Name="ChaptersButton" Grid.Column="6" Classes="player" ToolTip.Tip="Chapters (C)" IsVisible="{Binding HasChapters}">
                            <Path Classes="icon" Data="{x:Static k:Icons.Chapters}" />
                            <DropDownButton.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight" FlyoutPresenterClasses="player">
                                    <ScrollViewer MaxHeight="420">
                                        <ItemsControl x:Name="ChaptersPanel" Width="300" ItemsSource="{Binding Chapters}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ChapterChoice">
                                                    <Button Classes="playerRow" Command="{Binding ChooseCommand}">
                                                        <Grid ColumnDefinitions="26,*,Auto">
                                                            <Path Classes="icon" Data="{x:Static k:Icons.Check}" Stroke="White" Width="16" Height="16"
                                                                  HorizontalAlignment="Left" IsVisible="{Binding IsSelected}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" Opacity="0.6" Margin="12,0,0,0" FontFeatures="tnum" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <DropDownButton x:Name="SpeedButton" Grid.Column="7" Classes="player" ToolTip.Tip="Speed (− and +)">
                            <Panel>
                                <Path Classes="icon" Data="{x:Static k:Icons.Speed}" IsVisible="{Binding !IsRateChanged}" />
                                <TextBlock Text="{Binding RateText}" FontWeight="SemiBold" IsVisible="{Binding IsRateChanged}" MinWidth="22"
                                           TextAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                            <DropDownButton.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight" FlyoutPresenterClasses="player">
                                    <ItemsControl x:Name="SpeedPanel" Width="180" ItemsSource="{Binding Speeds}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SpeedChoice">
                                                <Button Classes="playerRow" Command="{Binding ChooseCommand}">
                                                    <Grid ColumnDefinitions="26,*">
                                                        <Path Classes="icon" Data="{x:Static k:Icons.Check}" Stroke="White" Width="16" Height="16"
                                                              HorizontalAlignment="Left" IsVisible="{Binding IsSelected}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <DropDownButton x:Name="AudioButton" Grid.Column="8" Classes="player" ToolTip.Tip="Audio (A next track, V clear voices)">
                            <Path Classes="icon" Data="{x:Static k:Icons.Audio}" />
                            <DropDownButton.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight" FlyoutPresenterClasses="player">
                                    <StackPanel x:Name="AudioPanel" Width="280" Spacing="2">
                                        <ItemsControl ItemsSource="{Binding AudioTracks}" ItemTemplate="{StaticResource TrackRow}" IsVisible="{Binding HasAudioChoice}" />
                                        <Border Height="1" Background="#22FFFFFF" Margin="4,6" IsVisible="{Binding HasAudioChoice}" />
                                        <Button Classes="playerRow" Command="{Binding ToggleClearVoicesCommand}"
                                                ToolTip.Tip="Lower rumbles, clearer dialogue: an equalizer, it doesn't even out loud and quiet scenes">
                                            <Grid ColumnDefinitions="26,*">
                                                <Path Classes="icon" Data="{x:Static k:Icons.Check}" Stroke="White" Width="16" Height="16"
                                                      HorizontalAlignment="Left" IsVisible="{Binding ClearVoices}" />
                                                <TextBlock Grid.Column="1" Text="Clear voices (V)" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <DropDownButton x:Name="SubtitlesButton" Grid.Column="9" Classes="player" ToolTip.Tip="Subtitles (S)">
                            <Path Classes="icon" Data="{x:Static k:Icons.Subtitles}" />
                            <DropDownButton.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight" FlyoutPresenterClasses="player">
                                    <StackPanel Width="280" Spacing="2">
                                        <ItemsControl ItemsSource="{Binding SubtitleTracks}" ItemTemplate="{StaticResource TrackRow}" />
                                        <Border Height="1" Background="#22FFFFFF" Margin="4,6" />
                                        <Grid ColumnDefinitions="*,Auto,64,Auto" Margin="10,2">
                                            <TextBlock Text="Delay" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="player step" Content="−" Command="{Binding SubtitlesEarlierCommand}" ToolTip.Tip="Earlier (G)" />
                                            <Button Grid.Column="2" Classes="playerRow" Padding="0,6" Command="{Binding ResetSubtitleDelayCommand}" ToolTip.Tip="Back to zero">
                                                <TextBlock Text="{Binding SubtitleDelayText}" HorizontalAlignment="Center" FontFeatures="tnum" />
                                            </Button>
                                            <Button Grid.Column="3" Classes="player step" Content="+" Command="{Binding SubtitlesLaterCommand}" ToolTip.Tip="Later (H)" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto,64,Auto" Margin="10,2">
                                            <TextBlock Text="Size" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="player step" Content="−" Command="{Binding SubtitlesSmallerCommand}" ToolTip.Tip="Smaller" />
                                            <TextBlock Grid.Column="2" Text="{Binding SubtitleScaleText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFeatures="tnum" />
                                            <Button Grid.Column="3" Classes="player step" Content="+" Command="{Binding SubtitlesBiggerCommand}" ToolTip.Tip="Bigger" />
                                        </Grid>
                                        <Border Height="1" Background="#22FFFFFF" Margin="4,6" />
                                        <Button Classes="playerRow" Content="Find subtitles…" IsVisible="{Binding CanFindSubtitles}" Click="OnFindSubtitles" />
                                        <Button Classes="playerRow" Content="Load a file…" Click="OnLoadSubtitles" />
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button Grid.Column="10" Classes="player" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Mute (M)">
                            <Panel>
                                <Path Classes="icon" Data="{x:Static k:Icons.Volume}" IsVisible="{Binding !IsMuted}" />
                                <Path Classes="icon" Data="{x:Static k:Icons.Muted}" IsVisible="{Binding IsMuted}" />
                            </Panel>
                        </Button>
                        <Slider Grid.Column="11" Width="110" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="2,0,10,0"
                                Value="{Binding Volume}" ToolTip.Tip="Volume (↑ ↓)" />
                        <ToggleButton Grid.Column="12" Classes="player" IsChecked="{Binding IsOnTop}" ToolTip.Tip="Keep the window over the others (T)">
                            <Path Classes="icon" Data="{x:Static k:Icons.Pin}" />
                        </ToggleButton>
                        <Button Grid.Column="13" Classes="player" Command="{Binding ToggleFullScreenCommand}" ToolTip.Tip="Full screen (F)">
                            <Panel>
                                <Path Classes="icon" Data="{x:Static k:Icons.FullScreen}" IsVisible="{Binding !IsFullScreen}" />
                                <Path Classes="icon" Data="{x:Static k:Icons.ExitFullScreen}" IsVisible="{Binding IsFullScreen}" />
                            </Panel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Panel>
</UserControl>
