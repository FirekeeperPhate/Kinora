<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kinora.ViewModels"
        xmlns:views="using:Kinora.Views"
        xmlns:k="using:Kinora"
        x:Class="Kinora.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Kinora"
        Icon="/Assets/kinora-256.png"
        MinWidth="760" MinHeight="500"
        Background="{DynamicResource AppBackground}">

    <Window.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding ScanCommand}" />
    </Window.KeyBindings>

    <Panel>
        <!-- Library -->
        <Grid ColumnDefinitions="236,*" IsVisible="{Binding ShowLibrary}">

            <!-- Sidebar -->
            <Border Background="{DynamicResource SidebarBackground}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="22,22,22,18">
                        <Image Source="/Assets/kinora-64.png" Width="30" Height="30" />
                        <TextBlock Text="Kinora" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Movies or TV shows -->
                    <Border DockPanel.Dock="Top" Margin="16,0,16,10" Padding="3" CornerRadius="10" Background="{DynamicResource ChipBackground}">
                        <UniformGrid Columns="2">
                            <RadioButton Classes="segment" Content="Movies" IsChecked="{Binding IsMoviesMode}" GroupName="mode" />
                            <RadioButton Classes="segment" Content="TV shows" IsChecked="{Binding IsShowsMode}" GroupName="mode" />
                        </UniformGrid>
                    </Border>

                    <Button DockPanel.Dock="Bottom" Classes="nav" Margin="10,8,10,14" Padding="12,9"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Data="{x:Static k:Icons.Sliders}" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ListBox Classes="nav" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem" x:DataType="vm:NavItem">
                                <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <Panel>
                                    <TextBlock Classes="section" Text="{Binding Title}" Margin="0,14,0,2"
                                               IsVisible="{Binding IsHeader}" />
                                    <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsSelectable}">
                                        <Path Classes="icon" Data="{Binding Icon}" Width="17" Height="17" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                                            <Path Classes="icon" Data="{x:Static k:Icons.Offline}" Width="14" Height="14"
                                                  IsVisible="{Binding IsUnavailable}" ToolTip.Tip="Not reachable right now" />
                                            <TextBlock Text="{Binding CountText}" Classes="subtle" FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- Over the row, only for library folders: the right-click menu -->
                                    <Border Background="Transparent" IsVisible="{Binding IsRoot}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Mark all as watched" Command="{Binding MarkWatchedCommand}" />
                                                <MenuItem Header="Mark all as unwatched" Command="{Binding MarkUnwatchedCommand}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                    </Border>
                                </Panel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Main area -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">

                <Grid ColumnDefinitions="*,Auto" Margin="32,22,32,14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ViewTitle}" FontSize="27" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CountText}" Classes="subtle" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Classes="toolbar" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <StackPanel.Styles>
                            <Style Selector="StackPanel.toolbar > TextBox, StackPanel.toolbar > ComboBox, StackPanel.toolbar > Button, StackPanel.toolbar > ToggleButton, StackPanel.toolbar > SplitButton">
                                <Setter Property="Height" Value="38" />
                                <Setter Property="MinHeight" Value="38" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </StackPanel.Styles>
                        <Button Command="{Binding RandomCommand}" ToolTip.Tip="Open a title picked at random from this view" Padding="12,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon" Data="{x:Static k:Icons.Dice}" Width="16" Height="16" />
                                <TextBlock Text="Random" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="SearchBox" Width="270" PlaceholderText="Search title, actor, director"
                                 Text="{Binding SearchText}" Classes="clearButton" Padding="6,0" VerticalContentAlignment="Center">
                            <TextBox.InnerLeftContent>
                                <Path Classes="icon" Data="{x:Static k:Icons.Search}" Width="15" Height="15" Margin="12,0,2,0"
                                      Stroke="{DynamicResource SubtleText}" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" MinWidth="130" VerticalContentAlignment="Center"
                                  ToolTip.Tip="Sort by" />
                        <ToggleButton IsChecked="{Binding SortDescending}" ToolTip.Tip="Reverse the order" Padding="10,0">
                            <Path Classes="icon" Data="{x:Static k:Icons.Sort}" Width="16" Height="16" />
                        </ToggleButton>
                        <SplitButton Command="{Binding ScanCommand}" ToolTip.Tip="Look for new, changed and removed movies (F5)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon" Data="{x:Static k:Icons.Refresh}" Width="15" Height="15" />
                                <TextBlock Text="Scan" />
                            </StackPanel>
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Full scan (read every folder again)" Command="{Binding FullScanCommand}" />
                                    <MenuItem Header="Download missing metadata from TMDB" Command="{Binding FetchMissingCommand}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                    </StackPanel>
                </Grid>

                <!-- What to do with the selected titles -->
                <Border Grid.Row="1" IsVisible="{Binding HasSelection}" Margin="32,0,32,12" Padding="16,8" CornerRadius="12"
                        Background="{DynamicResource SurfaceBackground}" BoxShadow="0 4 14 0 #22000000">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Mark watched" Command="{Binding MarkSelectedWatchedCommand}" />
                            <Button Content="Mark unwatched" Command="{Binding MarkSelectedUnwatchedCommand}" />
                            <DropDownButton Content="Move to" IsVisible="{Binding CanMoveSelection}">
                                <DropDownButton.Flyout>
                                    <MenuFlyout ItemsSource="{Binding SelectionMoveTargets}">
                                        <MenuFlyout.ItemContainerTheme>
                                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:MoveTarget">
                                                <Setter Property="Header" Value="{Binding Name}" />
                                                <Setter Property="Command" Value="{Binding Command}" />
                                            </ControlTheme>
                                        </MenuFlyout.ItemContainerTheme>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button Content="Select all" Command="{Binding SelectAllCommand}" ToolTip.Tip="Everything in this view (Ctrl+A)" />
                            <Button Content="Clear" Command="{Binding ClearSelectionCommand}" ToolTip.Tip="Esc" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Poster grid: a virtualized list of rows -->
                <ScrollViewer Grid.Row="2" x:Name="GridScroller" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="GridItems" ItemsSource="{Binding Rows}" Margin="32,6,32,32">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MovieRow">
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,26">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="22" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CardViewModel">
                                            <Button Classes="card" Width="{Binding CardWidth}" Command="{Binding OpenCommand}"
                                                    ToolTip.Tip="{Binding Title}" ToolTip.ShowDelay="900">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Play" Command="{Binding PlayCommand}" />
                                                        <MenuItem Header="{Binding WatchedMenuText}" Command="{Binding ToggleWatchedCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="Show in folder" Command="{Binding RevealCommand}" />
                                                        <MenuItem Header="Identify…" Command="{Binding IdentifyCommand}" />
                                                        <MenuItem Header="Move to" ItemsSource="{Binding MoveTargets}" IsVisible="{Binding CanMove}">
                                                            <MenuItem.ItemContainerTheme>
                                                                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:MoveTarget">
                                                                    <Setter Property="Header" Value="{Binding Name}" />
                                                                    <Setter Property="Command" Value="{Binding Command}" />
                                                                </ControlTheme>
                                                            </MenuItem.ItemContainerTheme>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <StackPanel>
                                                    <Border Classes="poster" Classes.selected="{Binding IsSelected}" Height="{Binding PosterHeight}">
                                                        <Panel>
                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center"
                                                                       VerticalAlignment="Center" Margin="14" Classes="subtle"
                                                                       IsVisible="{Binding !HasPoster}" />
                                                            <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                                                            <Border IsVisible="{Binding Watched}" Width="26" Height="26" CornerRadius="13"
                                                                    Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Background="{DynamicResource AccentBrush}" ToolTip.Tip="Watched">
                                                                <Path Data="{x:Static k:Icons.Check}" Stroke="White" StrokeThickness="2.6"
                                                                      StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform"
                                                                      Width="13" Height="13" />
                                                            </Border>
                                                            <Border IsVisible="{Binding ShowUnwatchedCount}" MinWidth="26" Height="26" CornerRadius="13" Padding="7,0"
                                                                    Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Background="{DynamicResource AccentBrush}" ToolTip.Tip="Episodes not watched yet">
                                                                <TextBlock Text="{Binding UnwatchedCount}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <Border IsVisible="{Binding IsUnavailable}" CornerRadius="6" Padding="7,3"
                                                                    Margin="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                                    Background="#B0000000">
                                                                <TextBlock Text="Offline" Foreground="White" FontSize="11" />
                                                            </Border>
                                                            <!-- Select (top left) and quick actions (bottom right), shown on hover -->
                                                            <Button Classes="selectDot" Classes.show="{Binding ShowSelector}" Classes.selected="{Binding IsSelected}"
                                                                    Command="{Binding ToggleSelectCommand}" ToolTip.Tip="Select (Ctrl+click)"
                                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                                                <Path Data="{x:Static k:Icons.Check}" StrokeThickness="2.6" StrokeLineCap="Round" StrokeJoin="Round"
                                                                      Stretch="Uniform" Width="12" Height="12" Stroke="White" />
                                                            </Button>
                                                            <StackPanel Classes="cardActions" Orientation="Horizontal" Spacing="6"
                                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                                                                <Button Classes="cardAction" Classes.on="{Binding Watched}" Command="{Binding ToggleWatchedCommand}"
                                                                        ToolTip.Tip="{Binding WatchedMenuText}">
                                                                    <Path Data="{x:Static k:Icons.Check}" StrokeThickness="2.4" StrokeLineCap="Round" StrokeJoin="Round"
                                                                          Stretch="Uniform" Width="13" Height="13" Stroke="White" />
                                                                </Button>
                                                                <Button Classes="cardAction" Click="OnCardMoreClick" ToolTip.Tip="More">
                                                                    <Path Data="{x:Static k:Icons.More}" StrokeThickness="3" StrokeLineCap="Round"
                                                                          Stretch="Uniform" Width="14" Height="4" Stroke="White" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Panel>
                                                    </Border>
                                                    <TextBlock Classes="cardTitle" Text="{Binding Title}" Margin="2,10,2,0"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" Margin="2,2,2,0" FontSize="12" Classes="subtle" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty library -->
                <StackPanel Grid.Row="2" IsVisible="{Binding ShowEmptyLibrary}" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Spacing="14" MaxWidth="420" Margin="0,0,0,80">
                    <Image Source="/Assets/kinora-128.png" Width="88" Height="88" />
                    <TextBlock Text="{Binding EmptyLibraryTitle}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyLibraryText}" TextWrapping="Wrap" TextAlignment="Center" Classes="subtle" />
                    <Button Classes="accent" HorizontalAlignment="Center" Content="Add a folder"
                            Command="{Binding OpenSettingsCommand}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Nothing matches -->
                <StackPanel Grid.Row="2" IsVisible="{Binding HasNoResults}" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,80">
                    <TextBlock Text="Nothing here" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="No movie matches this view or search." Classes="subtle" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Scan status -->
                <Border Grid.Row="3" IsVisible="{Binding ShowStatus}" Background="{DynamicResource SidebarBackground}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="32,10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <ProgressBar Width="160" Minimum="0" Maximum="100" Value="{Binding ScanProgress}"
                                     IsIndeterminate="{Binding ScanIndeterminate}" IsVisible="{Binding IsScanning}"
                                     Margin="0,0,14,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ScanStatus}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelScanCommand}"
                                IsVisible="{Binding IsScanning}" Padding="12,4" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Movie page -->
        <views:MovieDetailView DataContext="{Binding Detail}"
                               IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <views:SeriesDetailView DataContext="{Binding SeriesDetail}"
                                IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SeriesDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <views:PersonView DataContext="{Binding Person}"
                          IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Person, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </Panel>
</Window>
