<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentBrush" Color="#E9503F" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D8402F" />
                    <SolidColorBrush x:Key="NavSelectedBackground" Color="#E3DCEC" />
                    <SolidColorBrush x:Key="NavHoverBackground" Color="#EAE5F0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentBrush" Color="#FF6A5C" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF8274" />
                    <SolidColorBrush x:Key="NavSelectedBackground" Color="#2E2740" />
                    <SolidColorBrush x:Key="NavHoverBackground" Color="#262033" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Line icons, drawn on a 24×24 grid -->
    <Style Selector="PathIcon, Path.icon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Path.icon">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{Binding $parent[TemplatedControl].Foreground}" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>

    <!-- Sidebar -->
    <Style Selector="ListBox.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NavHoverBackground}" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NavSelectedBackground}" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NavSelectedBackground}" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Movies / TV shows switch -->
    <Style Selector="RadioButton.segment">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="0,7">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center"
                                      FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.segment:checked">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
    </Style>
    <Style Selector="RadioButton.segment:not(:checked)">
        <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
    </Style>

    <!-- Poster cards -->
    <Style Selector="Button.card">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.card:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.card Border.poster">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PlaceholderBackground}" />
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.card:pointerover Border.poster">
        <Setter Property="RenderTransform" Value="scale(1.035)" />
        <Setter Property="BoxShadow" Value="0 10 24 0 #50000000" />
    </Style>
    <Style Selector="Button.card:pointerover TextBlock.cardTitle">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Accent button (Play) -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="22,10" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Round secondary buttons on the detail page -->
    <Style Selector="Button.pill, ToggleButton.pill, SplitButton.pill">
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{DynamicResource ChipBackground}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Border.badge">
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleText}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,1" />
    </Style>

    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
    </Style>
    <Style Selector="TextBlock.subtle">
        <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
    </Style>
</Styles>
