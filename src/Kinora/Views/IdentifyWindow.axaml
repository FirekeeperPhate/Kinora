<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kinora.ViewModels"
        x:Class="Kinora.Views.IdentifyWindow"
        x:DataType="vm:IdentifyViewModel"
        Title="Identify"
        Icon="/Assets/kinora-256.png"
        Width="680" Height="640" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}">

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <TextBlock Text="Which movie is this?" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="{Binding FileName}" Classes="subtle" TextTrimming="CharacterEllipsis" />
            <Grid ColumnDefinitions="*,90,Auto" Margin="0,10,0,4">
                <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="Title">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <TextBox Grid.Column="1" Text="{Binding YearText}" PlaceholderText="Year" Margin="8,0,0,0">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="2" Content="Search" Margin="8,0,0,0" Command="{Binding SearchCommand}" />
            </Grid>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
            <Button Content="This is the one" Classes="accent" Command="{Binding ChooseCommand}" />
        </StackPanel>

        <Panel>
            <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Background="Transparent"
                     DoubleTapped="OnResultDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:IdentifyResult">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                            <Border Width="62" Height="93" CornerRadius="6" ClipToBounds="True"
                                    Background="{DynamicResource PlaceholderBackground}">
                                <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,2,0,0" Spacing="3">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Details}" Classes="subtle" />
                                <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           FontSize="12" Classes="subtle" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSearching}" VerticalAlignment="Top" />
            <TextBlock Text="{Binding Message}" Classes="subtle" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Panel>
    </DockPanel>
</Window>
